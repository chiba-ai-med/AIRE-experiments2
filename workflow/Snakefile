# Phase 5: Plots — Contact map overview
# =====================================================================

rule plot_contact_maps:
    """NMF component contact map visualization."""
    input:
        W = "output/nmf_{res}/W_nmf_k{k}.tsv",
    output: "plot/contact_maps_{res}_k{k}.png"
    log:    "logs/plot_contact_maps_{res}_k{k}.log"
    conda:  CONDA_ENV
    shell:
        """
        python src/plot_contact_maps.py \
            --input output/nmf_{wildcards.res} \
            --k {wildcards.k} \
            --resolution {wildcards.res} \
            --output {output} \
            >& {log}
        """
