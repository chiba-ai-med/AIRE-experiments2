"""RIPHAMMER validation pipeline: simulation + mTEC + brain analyses.

Full DAG: vectorize → NMF fit → TAD detection → comparison → plots.
Every rule has conda: + log: + benchmark: for reproducibility.
"""
from snakemake.utils import min_version
min_version("8.10.0")

configfile: "workflow/config.yaml"

CONDA_ENV = "envs/riphammer.yaml"
CONDA_ENV_R = "envs/thunder.yaml"

# ── Derived constants ────────────────────────────────────────────────
RESOLUTIONS = config["resolutions"]           # [100000, 25000, 10000]
K_DEFAULT = config["nmf"]["n_components"]     # 8
MAX_ITER = config["nmf"]["max_iter"]          # 500
SEED = config["nmf"]["seed"]                  # 42
TAD_WINDOW = config["tad"]["window"]          # 500000

# Brain-specific K values
BRAIN_K_VALUES = config.get("brain", {}).get("k_values", [2, 3])

# Constrain {res} wildcard to numeric-only resolutions (avoids
# matching "brain_100000" in the generic fit/tad rules).
wildcard_constraints:
    res = r"\d+",

# ── Helper functions ─────────────────────────────────────────────────
def all_samples(resolution=None):
    samples = []
    for group, ginfo in config["samples"].items():
        min_res = ginfo.get("min_resolution", 100000)
        if resolution and resolution < min_res:
            continue
        for s in ginfo["entries"]:
            samples.append(s)
    return samples


# ── Target rule ──────────────────────────────────────────────────────
rule all:
    """Produce all final outputs: NMF results, TAD calls, and all 16 plots."""
    input:
        # --- mTEC+thymocyte NMF + TAD ---
        expand("output/nmf_{res}/W_nmf_k{k}.tsv",
               res=RESOLUTIONS, k=K_DEFAULT),
        expand("output/tad_{res}_k{k}/done",
               res=RESOLUTIONS, k=K_DEFAULT),
        # --- Brain NMF + TAD ---
        expand("output/nmf_brain_100000/W_nmf_k{k}.tsv", k=BRAIN_K_VALUES),
        "output/nmf_brain_100000_k2/W_nmf_k2.tsv",
        "output/tad_brain_100000_k3/done",
        # --- Simulation NMF ---
        "output/nmf_simulation_100000/W_nmf_k4.tsv",
        # --- THUNDER ---
        "output/simulation_100000/thunder_H_fullgenome.tsv",
        "output/simulation_100000/thunder_W_k4.tsv",
        # --- Intermediate comparison data ---
        "output/simulation_100000/comparison_results.npz",
        "output/simulation_100000/tad_comparison.npz",
        # --- All 16 plots ---
        "plot/simulation_fraction_recovery.png",
        "plot/method_comparison_simulation.png",
        "plot/method_comparison_4way.png",
        "plot/biological_discovery_comparison.png",
        "plot/locus_discovery_comparison.png",
        "plot/robustness_analysis.png",
        "plot/scalability_benchmark.png",
        "plot/noise_robustness.png",
        "plot/aire_collaborator_summary.png",
        "plot/aire_locus_10kb_components.png",
        "plot/aire_locus_10kb_deep.png",
        "plot/aire_locus_10kb_differential.png",
        "plot/aire_locus_10kb_insulation.png",
        "plot/aire_locus_10kb_selected.png",
        "plot/brain_dev_k2_100kb.png",
        "plot/brain_dev_loci_100kb.png",
        expand("plot/contact_maps_{res}_k{k}.png",
               res=RESOLUTIONS, k=K_DEFAULT),


# =====================================================================
# Phase 0: Vectorize (mcool → feature matrices)
# =====================================================================

rule vectorize:
    """Convert mcool files to feature matrices (mTEC + thymocyte)."""
    output:
        npy   = "output/features_{res}/X_bulk.npy",
        feat  = "output/features_{res}/features.tsv",
        cells = "output/features_{res}/cells.tsv",
    log:    "logs/vectorize_{res}.log"
    benchmark: "benchmarks/vectorize_{res}.txt"
    conda:  CONDA_ENV
    shell:
        """
        python src/vectorize.py \
            --config workflow/config.yaml \
            --resolution {wildcards.res} \
            --output output/features_{wildcards.res} \
            >& {log}
        """


rule vectorize_brain:
    """Convert brain-only mcool files to feature matrix (100kb)."""
    output:
        npy   = "output/features_brain_100000/X_bulk.npy",
        feat  = "output/features_brain_100000/features.tsv",
        cells = "output/features_brain_100000/cells.tsv",
    log:    "logs/vectorize_brain_100000.log"
    benchmark: "benchmarks/vectorize_brain_100000.txt"
    conda:  CONDA_ENV
    shell:
        """
        python src/vectorize_brain.py \
            --config workflow/config.yaml \
            --resolution 100000 \
            --output output/features_brain_100000 \
            >& {log}
        """


# =====================================================================
# Phase 1: NMF fit
# =====================================================================

rule fit:
    """Run Multi-band NMF (mTEC + thymocyte)."""
    input:
        npy = "output/features_{res}/X_bulk.npy",
    output:
        W = "output/nmf_{res}/W_nmf_k{k}.tsv",
        H = "output/nmf_{res}/H_nmf_k{k}.tsv",
    log:    "logs/fit_{res}_k{k}.log"
    benchmark: "benchmarks/fit_{res}_k{k}.txt"
    conda:  CONDA_ENV
    shell:
        """
        riphammer fit \
            -i output/features_{wildcards.res} \
            -o output/nmf_{wildcards.res} \
            --k {wildcards.k} \
            --n-iter {MAX_ITER} \
            --seed {SEED} \
            >& {log}
        """


rule fit_brain:
    """Run Multi-band NMF on brain data (100kb, variable K)."""
    input:
        npy = "output/features_brain_100000/X_bulk.npy",
    output:
        W = "output/nmf_brain_100000/W_nmf_k{k}.tsv",
        H = "output/nmf_brain_100000/H_nmf_k{k}.tsv",
    log:    "logs/fit_brain_100000_k{k}.log"
    benchmark: "benchmarks/fit_brain_100000_k{k}.txt"
    conda:  CONDA_ENV
    shell:
        """
        riphammer fit \
            -i output/features_brain_100000 \
            -o output/nmf_brain_100000 \
            --k {wildcards.k} \
            --n-iter {MAX_ITER} \
            --seed {SEED} \
            >& {log}
        """


rule fit_brain_k2:
    """Run Multi-band NMF on brain data (100kb, K=2, separate output dir)."""
    input:
        npy = "output/features_brain_100000/X_bulk.npy",
    output:
        W = "output/nmf_brain_100000_k2/W_nmf_k2.tsv",
        H = "output/nmf_brain_100000_k2/H_nmf_k2.tsv",
    log:    "logs/fit_brain_100000_k2.log"
    benchmark: "benchmarks/fit_brain_100000_k2.txt"
    conda:  CONDA_ENV
    shell:
        """
        riphammer fit \
            -i output/features_brain_100000 \
            -o output/nmf_brain_100000_k2 \
            --k 2 \
            --n-iter {MAX_ITER} \
            --seed {SEED} \
            >& {log}
        """


rule fit_simulation:
    """Run Multi-band NMF on simulation data (100kb, K=4)."""
    input:
        npy = "output/simulation_100000/X_bulk.npy",
    output:
        W = "output/nmf_simulation_100000/W_nmf_k4.tsv",
        H = "output/nmf_simulation_100000/H_nmf_k4.tsv",
    log:    "logs/fit_simulation_100000_k4.log"
    benchmark: "benchmarks/fit_simulation_100000_k4.txt"
    conda:  CONDA_ENV
    shell:
        """
        riphammer fit \
            -i output/simulation_100000 \
            -o output/nmf_simulation_100000 \
            --k 4 \
            --n-iter {MAX_ITER} \
            --seed {SEED} \
            >& {log}
        """


# =====================================================================
# Phase 2: TAD detection
# =====================================================================

rule tad:
    """Detect TADs from NMF components (mTEC + thymocyte)."""
    input:
        W = "output/nmf_{res}/W_nmf_k{k}.tsv",
    output:
        done = touch("output/tad_{res}_k{k}/done"),
    log:    "logs/tad_{res}_k{k}.log"
    benchmark: "benchmarks/tad_{res}_k{k}.txt"
    conda:  CONDA_ENV
    shell:
        """
        riphammer tad \
            -i output/nmf_{wildcards.res} \
            -o output/tad_{wildcards.res}_k{wildcards.k} \
            --k {wildcards.k} \
            --resolution {wildcards.res} \
            --window {TAD_WINDOW} \
            >& {log}
        """


rule tad_brain:
    """Detect TADs from brain NMF K=3 components."""
    input:
        W = "output/nmf_brain_100000/W_nmf_k3.tsv",
    output:
        done = touch("output/tad_brain_100000_k3/done"),
    log:    "logs/tad_brain_100000_k3.log"
    benchmark: "benchmarks/tad_brain_100000_k3.txt"
    conda:  CONDA_ENV
    shell:
        """
        riphammer tad \
            -i output/nmf_brain_100000 \
            -o output/tad_brain_100000_k3 \
            --k 3 \
            --resolution 100000 \
            --window {TAD_WINDOW} \
            >& {log}
        """


# =====================================================================
# Phase 3: THUNDER comparison (R)
# =====================================================================

rule thunder_fullgenome:
    """Run full-genome THUNDER pipeline (~28 min)."""
    input:
        tsv = "output/simulation_100000/thunder_input.tsv",
    output:
        H = "output/simulation_100000/thunder_H_fullgenome.tsv",
    log:    "logs/thunder_fullgenome.log"
    benchmark: "benchmarks/thunder_fullgenome.txt"
    conda:  CONDA_ENV_R
    shell:
        """
        Rscript src/run_thunder_fullgenome.R \
            {input.tsv} {output.H} \
            >& {log}
        """


rule thunder_extract_W:
    """Extract THUNDER W matrix (~5 min)."""
    input:
        tsv = "output/simulation_100000/thunder_input.tsv",
    output:
        W = "output/simulation_100000/thunder_W_k4.tsv",
        H = "output/simulation_100000/thunder_H_k4_raw.tsv",
    log:    "logs/thunder_extract_W.log"
    benchmark: "benchmarks/thunder_extract_W.txt"
    conda:  CONDA_ENV_R
    shell:
        """
        Rscript src/run_thunder_extract_W.R \
            {input.tsv} {output.W} {output.H} \
            >& {log}
        """


# =====================================================================
# Phase 4: Intermediate comparison data
# =====================================================================

rule comparison_3way:
    """Compute RIPHAMMER vs Standard NMF vs PCA comparison."""
    input:
        X    = "output/simulation_100000/X_bulk.npy",
        feat = "output/simulation_100000/features.tsv",
        frac = "output/simulation_100000/true_fractions.tsv",
        H    = "output/nmf_simulation_100000/H_nmf_k4.tsv",
    output:
        npz = "output/simulation_100000/comparison_results.npz",
    log:    "logs/comparison_3way.log"
    benchmark: "benchmarks/comparison_3way.txt"
    conda:  CONDA_ENV
    shell:
        """
        python src/compute_comparison_3way.py \
            output/simulation_100000 \
            output/nmf_simulation_100000 \
            {output.npz} \
            >& {log}
        """


rule tad_comparison:
    """Compute TAD boundary comparison across 3 methods."""
    input:
        X    = "output/simulation_100000/X_bulk.npy",
        feat = "output/simulation_100000/features.tsv",
        W    = "output/nmf_simulation_100000/W_nmf_k4.tsv",
        H    = "output/nmf_simulation_100000/H_nmf_k4.tsv",
        tw   = "output/simulation_100000/thunder_W_k4.tsv",
        th   = "output/simulation_100000/thunder_H_k4_raw.tsv",
    output:
        npz = "output/simulation_100000/tad_comparison.npz",
    log:    "logs/tad_comparison.log"
    benchmark: "benchmarks/tad_comparison.txt"
    conda:  CONDA_ENV
    shell:
        """
        python src/compute_tad_comparison.py \
            output/simulation_100000 \
            output/nmf_simulation_100000 \
            {output.npz} \
            >& {log}
        """


